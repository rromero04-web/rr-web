# URL del proyecto de Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave "anon public" de Supabase (Project Settings -> API -> anon public)
# Es segura para exponerse: el acceso real lo controla RLS (ver supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima

# URL pública del sitio en producción, usada en metadata/SEO y sitemap.
# En local puedes dejarla como está u omitirla.
NEXT_PUBLIC_SITE_URL=https://raulromero.es

# --- Notificación por email del formulario de contacto (opcional) ---
# Si no se configuran estas tres variables, el formulario sigue funcionando
# con normalidad: los datos se guardan en Supabase, simplemente no se envía
# ningún aviso por correo.

# Clave API de Resend (resend.com -> API Keys). Es secreta: no la subas
# al repositorio ni la compartas fuera de las variables de entorno.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Dirección donde quieres recibir el aviso de cada solicitud.
CONTACT_NOTIFICATION_EMAIL=info@raulromero.es

# Remitente con el que se envía el aviso. Requiere verificar el dominio
# raulromero.es en Resend (Domains -> Add Domain) antes de usarlo en
# producción; para pruebas puedes usar "onboarding@resend.dev".
CONTACT_FROM_EMAIL="Raúl Romero — Web & Growth <formulario@raulromero.es>"
